# Map tiles. A missing or failing style URL renders a readable error, not a grey box.
VITE_MAP_STYLE_URL=

# Turning a coordinate into a place name, for the station labels. Optional: with
# no URL here the editor never asks anyone for a name.
#   https://nominatim.example.org/reverse?format=jsonv2&lat={lat}&lon={lng}
VITE_GEOCODE_URL=

# Looking an address up, for the "add a waypoint" field. Optional and separate:
# a build may want one direction without the other. With no URL here the field
# takes coordinates only, and says so.
#   https://nominatim.example.org/search?format=jsonv2&limit=1&q={q}
VITE_GEOCODE_SEARCH_URL=
